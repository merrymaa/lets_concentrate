# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env НЕ должен попадать в git!

# Секретные ключи для подписи JWT (сгенерируйте уникальные длинные строки,
# например: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY_ACCESS=change-me-access-secret
JWT_SECRET_KEY_REFRESH=change-me-refresh-secret

# URL подключения к базе данных
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/concentrate
